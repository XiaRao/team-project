@startuml
'https://plantuml.com/class-diagram

abstract class TaskCollection {
  - nextUniqueID : int
  - tasks : Set<Task>
}

' The estimated number of hours needed to complete the task must be positive
' The completion progress must be an integer between 0 and 100. Both 0 and 100 are allowed.
abstract class Task {
  - uniqueID : int
  - title : String
  - description : String
  - deadline : Dates
  - estimatedHoursToCompleteTask : double
  - completionProgress : byte
  - difficultyLevel : byte
}

' 1 - Easy, 2 - Average, 3 - Difficult
abstract class DifficultyLevelMapping {
  - difficultyLevelToStringMapping : Map<int, String>
  - difficultyStringToLevelMapping : Map<String, int>
}

' Country code is in ISO 3166-1 alpha-2 code
abstract class Holiday {
  - countryCode : String
  - dates : Set<Dates>
}

DifficultyLevelMapping <--- Task
Task <-- TaskCollection

@enduml