@startuml
'https://plantuml.com/sequence-diagram

autonumber

actor "Human Student User" as humanStudentUser
boundary "BaseView" as baseView
control "LogOff" as logOffController
participant "LogOffInputBoundary <<Interface>>" as logOffInputBoundary
control "LogOffInteractor" as logOffInteractor
participant "LogOffOutputBoundary <<Interface>>" as logOffOutputBoundary
control "LogOffPresenter" as logOffPresenter
participant "BaseViewModel" as baseViewModel
participant "MonitoringViewModel" as monitoringViewModel
participant "ViewModelManager" as viewModelManager

== "Send Log Off Request" ==
humanStudentUser -> baseView: Request to log off
baseView -> logOffController: execute(RawRequestLogOffInputData)
logOffController -> logOffInputBoundary: execute(RequestLogOffInputData)
logOffInputBoundary -> logOffInteractor: execute(RequestLogOffInputData)
logOffInteractor -> logOffOutputBoundary: prepareConfirmationPopUp(ConfirmationPopUpOutputData)
logOffOutputBoundary -> logOffPresenter: prepareConfirmationPopUp(ConfirmationPopUpOutputData)
logOffPresenter -> baseViewModel: setState(confirmationPopUpState)
logOffPresenter <-- baseViewModel
logOffPresenter -> baseViewModel: firePropertyChange()
baseViewModel -> baseView: propertyChange()

== "Confirm Log Off Request" ==
humanStudentUser -> baseView: Confirm the log-off on the pop-up
baseView -> logOffController: execute(RawConfirmLogOffInputData)
logOffController -> logOffInputBoundary: execute(ConfirmLogOffInputData)
logOffInputBoundary -> logOffInteractor: execute(ConfirmLogOffInputData)
logOffInteractor -> logOffOutputBoundary: logOff(LogOffOutputData)
logOffOutputBoundary -> logOffPresenter: logOff(LogOffOutputData)
logOffPresenter -> baseViewModel: setState(LogOffClearingState)
logOffPresenter <-- baseViewModel
logOffPresenter -> baseViewModel: firePropertyChange()
baseViewModel -> baseView: propertyChange()
baseView --> logOffPresenter
logOffPresenter -> monitoringViewModel: clearState()
logOffPresenter <-- monitoringViewModel
logOffPresenter -> baseViewModel: clearState()
logOffPresenter <-- baseViewModel
logOffPresenter -> viewModelManager: changeView("Welcome")

== "Cancel Log Off Request" ==
humanStudentUser -> baseView: Cancel the log-off on the pop-up
baseView -> logOffController: execute(RawCancelLogOffInputData)
logOffController -> logOffInputBoundary: execute(CancelLogOffInputData)
logOffInputBoundary -> logOffInteractor: execute(CancelLogOffInputData)
logOffInteractor -> logOffOutputBoundary: logOff(CancelLogOffOutputData)
logOffOutputBoundary -> logOffPresenter: logOff(CancelLogOffOutputData)
logOffPresenter -> baseViewModel: setState(CancelLogOffState)
logOffPresenter <-- baseViewModel
logOffPresenter -> baseViewModel: firePropertyChange()
baseViewModel -> baseView: propertyChange()

@enduml